# Copy to .env and fill in. .env is git-ignored.
# OpenAI-compatible. The event's Tokenhub: base URL is enough, /chat/completions is added.
LLM_API_KEY=
LLM_ENDPOINT=https://api.tokenhubcloud.net/v1
# Model names depend on the key: use "查可用模型" in the web settings, or GET /v1/models.
LLM_MODEL=
# live | record | replay
TRADEDESK_MODE=

# --- Claude (Anthropic Messages API, official SDK: pip install anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# Through the event's Tokenhub (no /v1; the key is sent as a Bearer token):
# ANTHROPIC_API_BASE=https://api.tokenhubcloud.net
# LLM_EFFORT=medium
